# ─────────────────────────────────────────────────────────────
#  DECA Pirate Stock Game — environment variables
#  Copy to `.env` (root) for the server, and `web/.env` for the web app.
#  Real `.env` files are gitignored. The web Firebase config below is
#  PUBLIC and safe to expose (security comes from Firestore Rules +
#  the server authority, not from hiding these keys).
# ─────────────────────────────────────────────────────────────

# ── Server (authority service) ──
PORT=8081
CORS_ORIGIN=http://localhost:5173
# Deterministic game seed — same seed => same hidden price paths + news.
GAME_SEED=blackbeard-2026
# Firebase Admin service-account JSON, single line. DO NOT COMMIT the real value.
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"decastockenvision","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@decastockenvision.iam.gserviceaccount.com"}
# When using the Firestore emulator locally (optional):
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ── Web (Vite) — Firebase web config (public, safe to expose) ──
VITE_FIREBASE_API_KEY=AIzaSyAdvtA70pL2vO2dKi1cKe5X_4gfRXfhyp8
VITE_FIREBASE_AUTH_DOMAIN=decastockenvision.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=decastockenvision
VITE_FIREBASE_STORAGE_BUCKET=decastockenvision.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=389186106747
VITE_FIREBASE_APP_ID=1:389186106747:web:414844bc95370a3a51b9de
VITE_FIREBASE_MEASUREMENT_ID=G-BS9SP7V1JS
# Base URL of the authority service (trade + admin endpoints):
VITE_API_BASE=http://localhost:8081
