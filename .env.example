# ─────────────────────────────────────────────────────────────
#  Buccaneer Exchange — environment variables
#  Copy to `.env` (root) for the server, and `web/.env` for the web app.
#  Real `.env` files are gitignored.
#
#  There is no cloud project and no third-party service: the server owns its
#  data in a SQLite file, issues its own session tokens and serves the built
#  web app. Every value below is optional — the defaults run a local game.
# ─────────────────────────────────────────────────────────────

# ── Server (authority service) ──
# HTTP port.
PORT=8081
# Allowed browser origin(s), comma-separated. `*` allows any (dev only).
# Not needed when the server serves the built app from the same origin.
CORS_ORIGIN=http://localhost:5173
# SQLite database. The server owns ALL of its data here; the folder is created
# on open and ':memory:' is allowed for throwaway runs.
DB_FILE=./data/game.db
# Built web app to serve as static files. Unset = `web/dist` next to the server.
# WEB_DIR=/srv/buccaneer/web
# API requests a minute per signed-in session (per IP when signed out). Static
# files, /health and the SSE stream never count. Default 600.
# RATE_LIMIT_MAX=600
# Deterministic game seed — the same seed reproduces the hidden market.
# Leave unset in production: `npm run seed` generates a high-entropy seed and
# stores it server-only in `meta.seed`. NEVER expose it to players.
GAME_SEED=blackbeard-2026
# HS256 signing key for session tokens. Unset = the server generates one on
# first use and keeps it in `meta.session_secret`, so restarts keep sessions
# valid. Set it only to share sessions across processes or fresh storage.
# SESSION_SECRET=
# Host (admin) password. Applied at every start when set; otherwise the first
# seed generates one and prints it once.
# ADMIN_PASSWORD=

# ── Web (Vite) ──
# Base URL of the authority service. Leave empty when the server serves the
# built app itself (same origin).
VITE_API_BASE=http://localhost:8081
