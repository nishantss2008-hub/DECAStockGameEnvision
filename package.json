{
  "name": "deca-pirate-stock-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "start": "npm run start -w @deca/server",
    "gcp-build": "npm run build:shared",
    "build": "npm run build -w @deca/shared && npm run build -w @deca/server && npm run build -w @deca/web",
    "build:shared": "npm run build -w @deca/shared",
    "build:web": "npm run build:shared && npm run build -w @deca/web",
    "dev:server": "npm run dev -w @deca/server",
    "dev:web": "npm run dev -w @deca/web",
    "dev:local": "bash scripts/dev-local.sh",
    "seed": "npm run seed -w @deca/server",
    "reset": "npm run reset -w @deca/server",
    "set-host-password": "npm run set-host-password -w @deca/server",
    "test": "npm run test -w @deca/server",
    "test:integration": "npm run test:int -w @deca/server"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
