rules_version = '2';

// DECA Stock Game (Buccaneer Exchange v2) — Firestore Security Rules
// ---------------------------------------------------------------------------
// Security model (spec §7):
//   * The authority service is the ONLY writer of real data. It uses the
//     Firebase Admin SDK, which BYPASSES these rules entirely. Therefore every
//     rule below denies client writes — there is intentionally no `allow write`.
//   * Clients (web app) may READ public data and their OWN crew's data only.
//     They can never read another crew's private data, the hidden future
//     (`_schedule`, `_engine`, `_teamStats`), logins (`_auth`) or the audit `logs`.
//   * Custom claims set by the server bind each signed-in user to a role and a
//     team:  request.auth.token.role    ('admin' | 'team')
//            request.auth.token.teamId  (the crew this user belongs to)
//
// Tests: server/test/integration/rules.int.test.ts (`npm run test:integration`).
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // -- Helpers --------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }
    // True when the signed-in user's claim ties them to the given teamId.
    function ownsTeam(teamId) {
      return isSignedIn() && request.auth.token.teamId == teamId;
    }
    // Top-level docs that carry a teamId field (trades, orders).
    function ownsDoc() {
      return isSignedIn() &&
        (request.auth.token.role == 'admin' ||
         resource.data.teamId == request.auth.token.teamId);
    }

    // -- Public (anyone) read ------------------------------------------------
    // Game clock, phase and settings.
    match /game/{doc} {
      allow read: if true;
    }

    // Companies and their public subcollections. The quality score and fair
    // value live only in server-only `_schedule` until the reveal is written
    // onto the company doc after the game ends.
    match /companies/{companyId} {
      allow read: if true;

      // Research profile (fundamentals/data). Also readable as a collection
      // group, below.
      match /fundamentals/{fundDoc} {
        allow read: if true;
      }

      // Price history chunks {chunk, startTick, prices[], volumes[]}: past and
      // present ticks only (the engine never writes the future here).
      match /history/{chunk} {
        allow read: if true;
      }
    }

    // Fundamentals are public research data, so the web app may read every
    // company's profile with ONE collection-group query
    // (collectionGroup('fundamentals')) instead of 25 document reads.
    // The server writes `fundamentals` only under companies/{id}; no private
    // data is ever stored in a collection of that name. Holdings and history
    // have no collection-group rule, so those sweeps stay denied.
    match /{path=**}/fundamentals/{doc} {
      allow read: if true;
    }

    // Market summary (composite index, sectors, breadth) and its composite
    // history chunks at market/summary/history/{chunk}.
    match /market/{doc=**} {
      allow read: if true;
    }

    // News feed (only published after an event fires; never the magnitude).
    match /news/{newsId} {
      allow read: if true;
    }

    // Standings (ranked totals, sparks, final research grades after the end).
    match /leaderboard/{doc} {
      allow read: if true;
    }

    // -- Crew-scoped read ----------------------------------------------------
    // A crew doc is readable by the host or by the crew it belongs to.
    match /teams/{teamId} {
      allow read: if isAdmin() || ownsTeam(teamId);

      match /holdings/{companyId} {
        allow read: if isAdmin() || ownsTeam(teamId);
      }

      // Total account value per tick, in chunks.
      match /history/{chunk} {
        allow read: if isAdmin() || ownsTeam(teamId);
      }
    }

    // Trades and orders: the host, or the crew named in the doc. Crew queries
    // must filter on teamId == their own id.
    match /trades/{tradeId} {
      allow read: if ownsDoc();
    }
    match /orders/{orderId} {
      allow read: if ownsDoc();
    }

    // -- Server-only collections (no client access) --------------------------
    // The hidden future: per-company quality, volatility and the news schedule
    // (with jump sizes), plus the game seed in _schedule/_meta.
    match /_schedule/{doc=**} {
      allow read, write: if false;
    }

    // Engine state {v, m, f, h} per company: fair value and impact.
    match /_engine/{doc=**} {
      allow read, write: if false;
    }

    // Research-grade accumulators (quality exposure per crew).
    match /_teamStats/{doc=**} {
      allow read, write: if false;
    }

    // Logins: crew and host password hashes (custom-token auth).
    match /_auth/{doc=**} {
      allow read, write: if false;
    }

    // Append-only audit log. Readable only through the Admin SDK (host console API).
    match /logs/{doc=**} {
      allow read, write: if false;
    }

    // -- Default deny --------------------------------------------------------
    // Any path not matched above (including the v1 per-tick
    // companies/{id}/priceHistory) and every client write is denied.
    // Firestore denies unmatched access implicitly; this rule documents it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
